{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecBack",
  "version": "1.0.0",
  "identifier": "com.secback.vault",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SecBack",
        "width": 1000,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
