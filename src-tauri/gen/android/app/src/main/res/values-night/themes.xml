<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.secback" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 退出 Android 15 起的强制 edge-to-edge（说明见 values/themes.xml）。
             深浅色两个主题都要写，否则系统切到深色模式后状态栏又被遮住。 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <!-- 深色模式下的状态栏/导航栏色，对应 style.css 深色主题的背景色 -->
        <item name="android:statusBarColor" tools:targetApi="21">#14161a</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#14161a</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">#14161a</item>
    </style>
</resources>
