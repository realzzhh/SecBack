# 仓库内统一 LF，检出时按平台处理。
# 这个项目要跨 Windows / macOS / Android，行尾不一致会天天产生假 diff。
* text=auto

*.png binary
*.ico binary
*.exe binary

# Rust / JS / JSON / MD 统一 LF
*.rs   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.css  text eol=lf
*.html text eol=lf
