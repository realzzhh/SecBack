# ---------------------------------------------------------------- 构建产物
# Rust 编译中间产物体积很大（src-tauri/target 就有 6GB+），绝不能进仓库
/target/
core/target/
src-tauri/target/

# Tauri 根据配置自动生成的 schema，每次构建会重建。
# 注意：gen/android 例外——那是真正的 Android 工程（gradle、Manifest 都要改），
# 属于源码，必须提交。
src-tauri/gen/schemas/

# ---------------------------------------------------------------- 依赖
node_modules/

# ---------------------------------------------------------------- 交付物（二进制）
# 安装包和 exe 走 GitHub Releases，不进版本库
delivery/*.exe
delivery/*.msi
delivery/*.dmg
delivery/*.AppImage

# ---------------------------------------------------------------- 敏感数据
# 密库文件：虽然是加密的，但没有任何理由进版本库
*.properties

# 本地真实配置（模板在 delivery/secback.cfg，那个是要提交的）
/secback.cfg

# ---------------------------------------------------------------- 调试与测试产物
# CDP 截图落在根目录时忽略；screenshots/ 里的是文档配图，要保留
/*.png

*.log
*.tmp

# Windows 保留设备名。用 /dev/null 干过什么事就会凭空出现一个，
# 而且常规手段删不掉（改名才能删）
nul
con
aux
prn

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.user
*.swp
*.swo

Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------- Android
# local.properties 里是本机 SDK 路径，每个人的机器都不一样
src-tauri/gen/android/local.properties
# 编译出来的 .so（debug 版 129MB）和 gradle 产物
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/buildSrc/build/

# 发布签名证书：含私钥和密码，绝不能入库
/keystore/

# 发布物及其校验清单保留在本机交付目录，不进入源码提交。
/delivery/**/*.apk
*.properties.bak*
*.properties.lock
*.tmp-*

# Non-secret Gradle build settings are required by a clean checkout.
!src-tauri/gen/android/gradle.properties
!src-tauri/gen/android/gradle/wrapper/gradle-wrapper.properties

# APK 校验清单随安装包交付，属于构建结果。
/delivery/**/*.manifest.json

# 个人本机清理脚本，保留文件但不提交。
/清理剩余构建缓存.ps1
